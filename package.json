{
  "name": "aries-next",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:admin": "pnpm --filter @aries/admin dev",
    "dev:web": "pnpm --filter @aries/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --if-present -r test",
    "sync:api": "cargo run -p aries-server --bin openapi-export --quiet > docs/openapi.yaml && pnpm --filter @aries/api-client generate"
  }
}
