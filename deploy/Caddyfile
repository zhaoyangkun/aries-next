# ============================================
# 全局配置：对整个 Caddy 服务器生效，不绑定任何域名
# 必须写在文件最前面
# ============================================
{
    # ACME 账户邮箱（用于 Let's Encrypt 证书注册与到期提醒，
    # 证书续期异常时 CA 会发邮件通知，建议填真实邮箱）
    email 2295098032@qq.com

    # 关闭 Admin API（默认监听 localhost:2019）
    # 关闭后无法用 caddy reload 热加载配置，需重启 Caddy 生效
    admin off
}

# ============================================
# 公共片段（snippet）
# 被多个站点通过 "import common" 复用，避免重复书写
# 片段名可以自定义，但要和 import 的名字一致
# ============================================
(common) {
    # 响应压缩：优先 zstd（速度快），不支持则回退 gzip（兼容性广）
    encode zstd gzip

    # 通用安全响应头，对所有响应生效
    header {
        # 禁止浏览器猜测内容类型，防止恶意文件被当脚本执行
        X-Content-Type-Options nosniff

        # 跳转时站外只发域名不发完整 URL，保护用户隐私
        Referrer-Policy strict-origin-when-cross-origin

        # 删除默认的 Server 响应头，隐藏服务器指纹
        -Server
    }
}

# 反代与 HTTPS 由 Caddy 全自动处理（ACME 申请/续期证书），只需把域名换成你的
# 公开站与 API 同站点；Admin SPA 由 aries-server 编入 Binary 在 /admin/ 下直出，
# 无需单独域名——/api/* 与 /admin/* 同源转发到后端（Session Cookie 与解锁 Cookie 都依赖这条同源链路）

cangmang.xyz {
    import common                        # 复用压缩与安全头
	# /admin 与 /admin/ 都要显式列出：path 通配 /admin/* 不匹配不带斜杠的 /admin，
	# 漏掉会落到默认 handle 被转给 Nuxt 404（后端 /admin 自身有 308 → /admin/）
	@backend path /api/* /admin /admin/*
	handle @backend {
		reverse_proxy aries-server:8088
	}

	handle {
		reverse_proxy aries-web:3000
	}
}