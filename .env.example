APP_ENV=development
SERVER_ADDR=0.0.0.0:8088
# HTTPS 部署时开启：所有 /api 响应携带 HSTS（Strict-Transport-Security），
# 未设置默认关闭；本地 HTTP 开发必须保持关闭，否则浏览器会强制升级子域名请求。
# 此处保持注释，避免开发用的 false 被误带到生产配置。
# SECURITY_HSTS=true
# 逗号分隔的精确 Origin 白名单，不支持通配符；Admin SPA 由服务端挂在 /admin/ 下，
# 生产环境写站点主域名的 HTTPS Origin（与浏览器地址栏一致），本地开发保留 5173
ADMIN_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://cangmang.xyz
# 是否挂载 OpenAPI 文档（Scalar UI，路径 /api/docs）。默认非 production 开启（本地开发
# 直接可看）、production 关闭——文档会暴露全部端点结构，生产如需打开显式设
# OPENAPI_DOCS=true（本地想关掉设 false）
# OPENAPI_DOCS=false
BOOTSTRAP_SECRET=replace-with-at-least-24-random-characters
# 生产环境必须替换为随机值（≥ 24 字符），只经环境注入，不得提交真实值。
SESSION_TTL_HOURS=12
# 生产环境建议显式设为 true；未设置时 production 默认 true，其余环境默认 false。
# 此处保持注释，避免开发用的 false 被误带到生产配置。
# SESSION_COOKIE_SECURE=false
RUST_LOG=aries_server=debug,tower_http=info
# 日志文件目录（相对 server 启动目录），按天切分为 aries-server.YYYY-MM-DD
LOG_DIR=./logs
# 日志文件保留天数，超出自动删除
LOG_RETENTION_DAYS=14
# SQL 慢查询阈值（毫秒，WARN 级记入运行日志）：默认 500，设为 0 关闭
DATABASE_SLOW_QUERY_MS=500
# 记录每条 SQL 语句（DEBUG 级）。未设置时：APP_ENV=production 默认 false，其余环境默认 true；
# 仅为启动初始值，运行期可在 Admin 运行日志页切换，无需重启
LOG_SQL=true
# 慢请求阈值（毫秒）：请求耗时达到即打 WARN 日志（带 path/status）。默认 1000，设为 0 关闭
LOG_SLOW_REQUEST_MS=1000
# ERROR 尖峰阈值：最近 5 分钟 ERROR 日志数达到即打 WARN。默认 10，设为 0 关闭
LOG_ERROR_SPIKE_THRESHOLD=10
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=aries
DATABASE_PASSWORD=aries
DATABASE_NAME=aries
DATABASE_SCHEMA=public
MIGRATION_MYSQL_URL=mysql://root:password@localhost:3306/aries
MIGRATION_POSTGRES_URL=postgres://aries:aries@localhost:5433/aries
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=./data/media
# 按需缩略图（?w=）磁盘缓存目录；缺省为 <MEDIA_LOCAL_DIR>/.thumbs
#MEDIA_THUMB_DIR=
MEDIA_PUBLIC_BASE_URL=/api/media/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
